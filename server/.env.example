# 运行环境
NODE_ENV=development

# 服务端口
PORT=3000

# JWT 密钥（生产环境请使用随机长字符串）
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars

# SQLite 数据库文件路径（相对于项目根目录）
DB_PATH=../data/qiju.db

# CORS 允许的来源（多个用逗号分隔，生产环境填写实际域名）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://124.222.97.96:8080

# 静态文件目录（相对于项目根目录，用于 Express 托管）
STATIC_DIR=../public
